# Maddy - submission-only SMTP relay for internal apps (no local mailboxes, no inbound MX).
# Uses Traefik's *.hopk.net cert (dumped by smtp-certs); clients must connect via smtp.hopk.net.
# Rendered by Ansible; edits here are overwritten on next deploy.

$(hostname) = smtp.hopk.net

hostname $(hostname)
state_dir /data
log stderr_ts

auth.pass_table local_authdb {
    table sql_table {
        driver sqlite3
        dsn credentials.db
        table_name passwords
    }
}

target.smtp relay_to_gmail {
    targets tcp://smtp.gmail.com:587
    auth plain "hopknetrelay@gmail.com" "{{ relayhost_password }}"
}

submission tcp://0.0.0.0:587 {
    hostname $(hostname)
    tls file /certs/hopk.net/fullchain.pem /certs/hopk.net/privkey.pem
    auth &local_authdb

    default_destination {
        deliver_to &relay_to_gmail
    }
}
