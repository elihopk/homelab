services:
  authelia:
    image: authelia/authelia:latest
    container_name: authelia
    ports:
      - 9959:9959
    volumes:
      - ./authelia/config:/config
      - ./authelia/secrets:/secrets
      - /var/log/authelia:/var/log/authelia
    depends_on:
      - "redis"
      - "smtp"
    restart: unless-stopped
    environment:
      - TZ=America/New_York
      - AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE=/secrets/JWT_SECRET
      - AUTHELIA_SESSION_SECRET_FILE=/secrets/SESSION_SECRET
      - AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE=/secrets/STORAGE_ENCRYPTION_KEY
      - AUTHELIA_STORAGE_POSTGRES_PASSWORD_FILE=/secrets/POSTGRES_PASSWORD
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.authelia.rule=Host(`auth.hopk.net`)"
      - "traefik.http.routers.authelia.entrypoints=https"
      - "traefik.http.routers.authelia.tls=true"
      - "traefik.http.routers.authelia.tls.certresolver=le"
      - "traefik.http.middlewares.cors.headers.customResponseHeaders.Access-Control-Allow-Origin=https://hopk.net/"
      - "traefik.http.middlewares.cors.headers.customResponseHeaders.Access-Control-Allow-Credentials=true"
      - "traefik.http.routers.authelia.middlewares=crowdsec@file, cors"
  traefik:
    image: traefik:latest
    container_name: traefik
    ports:
      - 80:80
      - 443:443
      - 8082:8082
    restart: unless-stopped
    environment:
      - PUID=1000
      - PGID=994
      - TZ=America/New_York
      - NAMECHEAP_API_USER={{ namecheap_api_user }}
      - NAMECHEAP_API_KEY={{ namecheap_api_key }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./traefik/certs:/certs
      - ./traefik/traefik.toml:/etc/traefik/traefik.toml
      - ./traefik/dyn.toml:/etc/traefik/dyn.toml
      - /var/log/traefik:/var/log/traefik
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.traefik.rule=Host(`traefik.hopk.net`)"
      - "traefik.http.routers.traefik.entrypoints=https"
      - "traefik.http.routers.traefik.tls=true"
      - "traefik.http.routers.traefik.tls.certresolver=le"
      - "traefik.http.routers.traefik.service=api@internal"
      - "traefik.http.routers.traefik.middlewares=chain-authelia@file"
  redis:
    image: redis:alpine
    container_name: redis
    volumes:
      - ./redis:/data
    restart: unless-stopped
    environment:
      - TZ=America/New_York
  crowdsec:
    image: crowdsecurity/crowdsec:latest
    container_name: crowdsec
    restart: unless-stopped
    ports:
      - 6060:6060
    volumes:
      - ./crowdsec/config:/etc/crowdsec
      - ./crowdsec/data:/var/lib/crowdsec/data
      - /var/log/auth.log:/logs/auth.log:ro
      - /var/log/syslog:/logs/syslog:ro
      - /var/log/traefik:/logs/traefik
      - /var/log/authelia:/logs/authelia
    environment:
      - PUID=1000
      - PGID=994
      - TZ=America/New_York
      - COLLECTIONS=LePresidente/authelia crowdsecurity/traefik crowdsecurity/linux
      - BOUNCER_KEY_TRAEFIK=ph
  smtp-certs:
    image: ldez/traefik-certs-dumper:latest
    container_name: smtp-certs
    restart: unless-stopped
    entrypoint: >-
      sh -c 'while ! [ -e /data/acme.json ] || ! [ `jq ".[] | .Certificates | length" /data/acme.json | jq -s "add"` != 0 ]; do sleep 1; done
      && traefik-certs-dumper file --version v3 --watch --source /data/acme.json --dest /out
      --domain-subdir --crt-name=fullchain --key-name=privkey --crt-ext=.pem --key-ext=.pem
      --post-hook "chmod -R a+rX /out"'
    volumes:
      - ./traefik/certs:/data:ro
      - ./smtp/certs:/out
  smtp:
    image: foxcpp/maddy:latest
    container_name: smtp
    restart: unless-stopped
    depends_on:
      - "smtp-certs"
    ports:
      - 587:587
    environment:
      - TZ=America/New_York
    volumes:
      - ./smtp:/data
      - ./smtp/certs:/certs:ro

  logrotate:
    image: blacklabelops/logrotate
    container_name: logrotate
    restart: unless-stopped
    volumes:
      - /var/log/authelia:/var/log/authelia
      - /var/log/traefik:/var/log/traefik
    environment:
      - TZ=America/New_York
      - LOGS_DIRECTORIES=/var/log/authelia /var/log/traefik
      - LOGROTATE_COMPRESSION=compress
