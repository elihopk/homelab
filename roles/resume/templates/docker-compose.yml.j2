services:
  resume:
    image: amruthpillai/reactive-resume:latest
    container_name: resume
    restart: unless-stopped
    ports:
      - "3000:3000"
    volumes:
      - ./resume:/app/data
    environment:
      # -- URLs --
      APP_URL: https://resume.hopk.net

      # -- Database (Postgres) --
      DATABASE_URL: postgresql://resume:{{ postgres_dbs.resume.password }}@{{ hostvars['db1'].ansible_host }}:5432/resume

      # -- Auth --
      AUTH_SECRET: {{ resume_auth_secret }}
      ENCRYPTION_SECRET: {{ resume_encryption_secret }}
      FLAG_DISABLE_SIGNUPS: "true"

      # -- Emails --
      SMTP_FROM: Reactive Resume <resume@hopk.net>
      SMTP_HOST: smtp.hopk.net
      SMTP_PORT: 587
      SMTP_USER: "relay@hopk.net"
      SMTP_PASS: "{{ smtp_relay_password }}"
      SMTP_SECURE: false
